{
  "name": "dsh-omnifile",
  "version": "0.1.0",
  "description": "DSH 文件适配插件：拖拽/粘贴/点击多选/@ 选择本地文件，anydoc 解析文档、多模态模型识别图片（含内容哈希缓存），聊天内文件卡片与会话内消息导航，并为文本-only 主模型提供 omnifile-* 图像变体。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/host/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:host": "vite build --config vite.host.config.mts",
    "build:common": "vite build --config vite.common.config.mts",
    "build:client": "vite build --config vite.client.config.mts",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "file-upload",
    "drag-drop",
    "paste",
    "anydoc",
    "document-parsing",
    "ocr",
    "multimodal",
    "vision",
    "file-card",
    "attachment",
    "conversation",
    "navigation",
    "text-extraction",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@firecrawl/anydoc": "^0.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.21.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
